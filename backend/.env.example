# LLM (ollama 또는 vllm)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
VLLM_API_URL=http://127.0.0.1:8008/v1
VLLM_API_KEY=EMPTY

# 원격 MES API (DB_BACKEND=mes_api 일 때만)
MES_API_URL=
MES_API_KEY=
CHROMA_PATH=./vector_index
RAG_TOP_K=8

# 스키마 임베딩. 논문 구성은 bge-m3(1024차원, 다국어).
# EMBED_BACKEND=default 로 두면 Chroma 기본 임베딩(영어 전용)을 쓴다.
EMBED_MODEL=bge-m3
EMBED_BACKEND=ollama

# SQL 실행 대상 (demo: 가상 데이터 DB, mes_api: 원격 MES API)
DB_BACKEND=demo
# 날짜 기준 (production: 오늘 기준, dev_last_year: 1년 전 기준)
MES_DATE_MODE=production

# 데모 DB (루트 docker-compose.yml 의 mes-db)
DEMO_DB_HOST=localhost
DEMO_DB_PORT=1433
DEMO_DB_USER=sa
DEMO_DB_PASSWORD=루트_.env_의_MSSQL_SA_PASSWORD
DEMO_DB_NAME=MES_DEMO
DEMO_DB_READER_USER=mes_reader
DEMO_DB_READER_PASSWORD=demo-db/02_create_reader.sql_실행시_정한_비밀번호
