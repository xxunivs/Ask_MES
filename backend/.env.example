LLM_PROVIDER=vllm
LLM_MODEL=qwen35-9b
VLLM_API_URL=http://127.0.0.1:8008/v1
VLLM_API_KEY=EMPTY
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen35-9b
MES_API_URL=https://your-cloudflare-tunnel.trycloudflare.com
MES_API_KEY=your_api_key_here
CHROMA_PATH=./vector_index
RAG_TOP_K=8

# 스키마 임베딩. 논문 구성은 bge-m3(1024차원, 다국어).
# EMBED_BACKEND=default 로 두면 Chroma 기본 임베딩(영어 전용)을 쓴다.
EMBED_MODEL=bge-m3
EMBED_BACKEND=ollama

# 역할 기반 모호어 해석 (기본 꺼짐. 켜면 role_pipeline 경유)
USE_ROLE_RESOLUTION=false
