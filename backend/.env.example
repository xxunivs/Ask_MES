# LLM (ollama, vllm, deepinfra)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
OLLAMA_URL=http://localhost:11434
VLLM_API_URL=http://127.0.0.1:8008/v1
VLLM_API_KEY=EMPTY
DEEPINFRA_API_KEY=

# 임베딩 (ollama, deepinfra), 공개 데모는 deepinfra + BAAI/bge-m3
EMBED_BACKEND=ollama
EMBED_MODEL=bge-m3
CHROMA_PATH=./vector_index
RAG_TOP_K=8

# SQL 실행 대상 (sqlite: 가상 데이터 파일, demo: 가상 데이터 SQL Server, mes_api: 실제 MES API)
DB_BACKEND=sqlite
# 날짜 기준 (비우면 sqlite 는 오늘, 그 외는 1년 전)
MES_DATE_MODE=

# DB_BACKEND=mes_api
MES_API_URL=
MES_API_KEY=

# DB_BACKEND=demo (루트 docker-compose.yml 의 SQL Server)
DEMO_DB_HOST=localhost
DEMO_DB_PORT=1433
DEMO_DB_USER=sa
DEMO_DB_PASSWORD=
DEMO_DB_NAME=MES_DEMO
DEMO_DB_READER_USER=mes_reader
DEMO_DB_READER_PASSWORD=

# 웹에서 API 를 부를 수 있는 주소 (쉼표 구분)
CORS_ORIGINS=*
